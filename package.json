{
  "name": "drtpos",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta - DRT POS",
  "author": "DRT Solutions SAS",
  "main": "electron/main.js",
  "scripts": {
    "ng:serve": "cd frontend && ng serve",
    "electron:serve": "cross-env ELECTRON_START_URL=http://localhost:4200 electron ./electron/main.js",
    "dev": "concurrently \"npm run ng:serve\" \"npm run electron:serve\"",
    "build:web": "cd frontend && ng build --configuration production",
    "build:web:electron": "cd frontend && ng build --configuration electron",
    "build:electron": "npm run build:web:electron && electron-builder --publish=never",
    "build:electron:no-sign": "npm run build:web:electron && electron-builder --publish=never --config.win.signAndEditExecutable=false --config.compression=store",
    "build:portable": "npm run build:web:electron && electron-builder --win portable --publish=never",
    "dist:simple": "npm run build:web && electron-builder --win dir --publish=never",
    "build:folder-only": "npm run build:web:electron && electron-builder --win dir --publish=never",
    "clean:cache": "if exist node_modules\\.cache rmdir /s /q node_modules\\.cache & if exist frontend\\node_modules\\.cache rmdir /s /q frontend\\node_modules\\.cache",
    "clean:all": "if exist release rmdir /s /q release & if exist node_modules\\.cache rmdir /s /q node_modules\\.cache & if exist frontend\\node_modules\\.cache rmdir /s /q frontend\\node_modules\\.cache"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "38.1.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.drtpos.app",
    "productName": "DRT POS",
    "files": [
      "frontend/dist/frontend/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "puppeteer": "^24.29.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.2"
  }
}
